# Copia este archivo a .env y rellena los valores en tu entorno local.
# Las variables del entorno real tienen prioridad sobre este archivo.
# No subas .env al repositorio.

# Clave secreta de Django (obligatoria en producción).
DJANGO_SECRET_KEY=

# Clave de la API de HenrikDev. Sin ella, el tracker devuelve un aviso de
# configuración (HTTP 503) y no realiza peticiones.
HENRIKDEV_API_KEY=

# Tiempo máximo de espera por petición, en segundos. Por defecto: 8.
HENRIKDEV_TIMEOUT=

# Tiempo máximo de espera queda acotado a 30 s aunque se indique más.

# Número de partidas recientes a analizar. Por defecto: 10 (rango 1-20).
HENRIKDEV_MATCH_SIZE=

# IP/CIDR verificado del proxy; obligatorio fuera del perfil automático Render.
# No usar redes amplias como sustituto de la IP real del proxy.
DJANGO_TRUSTED_PROXY_IPS=

# Límites del perfil público: 12 búsquedas por 60 s y por IP; backoff máximo 300 s.
# En producción multi-worker/instancia usa un cache compartido (Redis).
TRACKER_RATE_LIMIT=
TRACKER_RATE_WINDOW=
TRACKER_BACKOFF_MAX=
TRACKER_RATE_MAX_KEYS=

# Límite de intentos de acceso a /notas/ por IP.
NOTES_LOGIN_RATE_LIMIT=
NOTES_LOGIN_RATE_WINDOW=

# Cache para rate limiting. Recomendado en producción: backend compartido.
# Ejemplo Redis: DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1
DJANGO_CACHE_BACKEND=
DJANGO_CACHE_LOCATION=

# Contraseña compartida de /notas/ y credenciales de Supabase.
JKVAL_NOTES_PASSWORD=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Obligatorio con jkval.production: mismo Redis privado para todas las instancias.
# Usar rediss:// si el proveedor requiere TLS. No publicar Redis en Internet.
DJANGO_REDIS_URL=
