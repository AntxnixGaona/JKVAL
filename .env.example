# Copia este archivo a .env y rellena los valores en tu entorno local.
# Las variables del entorno real tienen prioridad sobre este archivo.
# No subas .env al repositorio.

# Clave secreta de Django (obligatoria en producción).
DJANGO_SECRET_KEY=

# Clave de la API de HenrikDev. Sin ella, el tracker devuelve un aviso de
# configuración (HTTP 503) y no realiza peticiones.
HENRIKDEV_API_KEY=

# Tiempo máximo de espera por petición, en segundos. Por defecto: 8.
HENRIKDEV_TIMEOUT=

# Número de partidas recientes a analizar. Por defecto: 10 (rango 1-20).
HENRIKDEV_MATCH_SIZE=
